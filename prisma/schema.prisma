generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Plan {
  id_plan  Int       @id @default(autoincrement())
  nombre   String
  materias Materia[]

  @@map("plan")
}

model Semestre {
  id_semestre Int       @id @default(autoincrement())
  numero      Int
  nombre      String
  materias    Materia[]

  @@map("semestre")
}

model Docente {
  id_docente Int       @id @default(autoincrement())
  nombre     String
  correo     String?
  horarios   Horario[]

  @@map("docente")
}

model Materia {
  id_materia       Int    @id @default(autoincrement())
  nombre           String
  id_plan          Int
  id_semestre      Int
  id_prerrequisito Int?
  sigla            String

  plan          Plan      @relation(fields: [id_plan], references: [id_plan])
  semestre      Semestre  @relation(fields: [id_semestre], references: [id_semestre])
  prerrequisito Materia?  @relation("MateriaPrerrequisito", fields: [id_prerrequisito], references: [id_materia])
  prerequisitos Materia[] @relation("MateriaPrerrequisito")
  horarios      Horario[]

  @@index([id_plan])
  @@index([id_semestre])
  @@index([id_prerrequisito])
  @@map("materia")
}

model Horario {
  id_horario  Int    @id @default(autoincrement())
  id_materia  Int
  id_docente  Int
  dia         String
  hora_inicio String
  hora_fin    String
  paralelo    String

  materia Materia @relation(fields: [id_materia], references: [id_materia])
  docente Docente @relation(fields: [id_docente], references: [id_docente])

  @@index([id_materia])
  @@index([id_docente])
  @@map("horario")
}
